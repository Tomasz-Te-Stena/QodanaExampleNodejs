{
  "name": "qodana-example-nodejs",
  "version": "1.0.0",
  "description": "Intentionally vulnerable Node.js application for security pipeline testing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^16.0.0",
    "supertest": "^7.3.2"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "server.js"
    ],
    "coverageReporters": [
      "text",
      "cobertura"
    ]
  }
}
